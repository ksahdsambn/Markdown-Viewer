# PERF-019: Exclude unnecessary files from Docker build context
.git
.github
.gitignore
.dockerignore
desktop-app
wiki
node_modules
*.md
LICENSE
docker-compose.yml
Dockerfile

# Exclude large demo assets not needed at runtime
assets/live-peview.gif
assets/*.gif

# CI confidentiality: inject credentials at runtime or with BuildKit --secret.
**/.git
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.sample
!**/.env.template
**/.ssh
**/.aws
**/.azure
**/.kube
**/.docker/config.json
**/.npmrc
**/.pypirc
**/id_rsa
**/id_ecdsa
**/id_ed25519
**/*.key
**/*.p12
**/*.pfx
**/*private*.pem
**/*-key.pem
**/*_key.pem
secrets/
**/.secrets/
